# Backend environment – used by Express only
# Copy to backend/.env (this file is git-ignored)

# Firebase (required for Firestore) – use one of:
# GOOGLE_APPLICATION_CREDENTIALS=your-firebase-adminsdk-*.json   (path relative to project root)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# On Render: run `pnpm run encode:firebase` and set FIREBASE_SERVICE_ACCOUNT_BASE64 to the output.

# Admin login
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe123!

# Cloudinary (required for PDF and cover image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS: frontend origin (e.g. https://www.kigalisafetytraining.com or http://localhost:8080)
# FRONTEND_URL=https://www.kigalisafetytraining.com

# Server
# PORT=8085

# Deploy (e.g. Render)
# API_ONLY=true
# RENDER=true

# Admin email notifications (optional): when someone registers or submits contact, admin receives an email.
# Registration email includes: name, email, phone, organization, sector.
# Contact email includes: name, email, phone, and message.
#
# Preferred: Brevo (transactional API). If BREVO_API_KEY is set, it is used instead of SMTP.
# Create an API key in Brevo; verify the sender domain or single sender you use.
# BREVO_API_KEY=xkeysib-...
# BREVO_SENDER_EMAIL=verified-sender@yourdomain.com
# BREVO_SENDER_NAME=KSOSHTC
#
# Fallback: SMTP (e.g. Gmail). If BREVO_API_KEY is unset, these are used.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false
# SMTP_FROM=KSOSHTC <your-email@gmail.com>

# Optional: Netlify form detection. Backend POSTs to this URL so submissions appear in Netlify Forms (default: FRONTEND_URL).
# NETLIFY_FORM_SUBMIT_URL=https://www.kigalisafetytraining.com
